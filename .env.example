# Database Configuration
DATABASE_URL=sqlite:///./cmf_platform.db

# LLM Configuration
LLM_PROVIDER=gemini # Option: gemini, openai, anthropic, ollama
LLM_API_KEY=your_api_key_here
MODEL_NAME=gemini-1.5-pro

# Application Settings
ENVIRONMENT=development
MAX_QUERY_ROWS=100
MAX_RETRIES=3
ENABLE_LOCAL_LLM=False
ENFORCE_READ_ONLY_SQL=True
ALLOW_DATA_CHANGES=True
WRITE_MAX_ROWS=50
SENSITIVE_COLUMNS=password,passwd,secret,token,api_key,apikey,ssn,card_number,cvv,pin_code

# Data changes requested in chat (always need admin approval)
ALLOW_DATA_CHANGES=True
WRITE_MAX_ROWS=50
SENSITIVE_COLUMNS=password,passwd,secret,token,api_key,apikey,ssn,card_number,cvv,pin_code

# Persistent Memory & Embedding Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
MEMORY_MAX_RESULTS=10
MEMORY_TOKEN_BUDGET=4000
MEMORY_AUTO_EXTRACT=True
MEMORY_DEFAULT_STATUS=pending
CONVERSATION_HISTORY_TURNS=6

# Hybrid Retrieval Weights (must sum to 1.0)
RETRIEVAL_WEIGHT_VECTOR=0.45
RETRIEVAL_WEIGHT_KEYWORD=0.20
RETRIEVAL_WEIGHT_RECENCY=0.15
RETRIEVAL_WEIGHT_IMPORTANCE=0.10
RETRIEVAL_WEIGHT_TYPE=0.10
